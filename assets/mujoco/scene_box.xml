<!-- sim2sim scene: the 29-DoF G1 with dummy box hands (head depth camera d435_depth at
     47.6 deg) and the 205 x 125 x 280 mm, 0.6 kg box on the floor. deploy/sim2sim.py
     places robot and box at the reference motion's frame 0. -->
<mujoco model="g1 box sim2sim">
  <include file="g1_29dof_dummyhands.xml"/>
  <include file="ground_box.xml"/>
  <option timestep="0.001"/>
</mujoco>
